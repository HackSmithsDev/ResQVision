# ======================
# Project
# ======================
PROJECT_NAME=ResQVision
ENVIRONMENT=development

# ======================
# Server
# ======================
HOST=0.0.0.0
PORT=8084
DEBUG=False
WORKERS_COUNT=1

# ======================
# Security
# ======================
SECRET_KEY=your_secret_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ======================
# Database
# ======================
DATABASE_URL=postgresql://<your_username_here>:<your_password_here>@localhost:5432/resqvision

# ======================
# Redis
# ======================
REDIS_URL=redis://localhost:6379/0

# ======================
# CORS
# ======================
BACKEND_CORS_ORIGINS=["*"]

# ======================
# Email (SMTP)
# ======================
MAIL_USERNAME=your_email_username_here
MAIL_PASSWORD=your-titan-mailbox-password
MAIL_FROM=your_email_from_address
MAIL_FROM_NAME=ResQVision Official
MAIL_SERVER=smtp.titan.email
MAIL_PORT=465

# ======================
# AI Keys
# ======================
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
GROK_API_KEY=your_grok_api_key_here

# ======================
# Admin
# ======================
ADMIN_EMAIL=your_admin_email_here

# ======================
# Tactical AI (Ollama - Level 3)
# ======================
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=resq-tactical:latest
OLLAMA_FALLBACK_MODEL=llama3.2:3b
OLLAMA_TIMEOUT_SECONDS=90.0